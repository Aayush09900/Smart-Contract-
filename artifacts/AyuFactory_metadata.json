		"userdoc": {
			"kind": "user",
			"methods": {
				"createAccount(address,address[],uint256,uint256)": {
					"notice": "Deploys the account if it doesn't exist yet, and returns its address.         Safe to call multiple times — returns existing address if already deployed."
				},
				"getAddress(address,address[],uint256,uint256)": {
					"notice": "Returns the deterministic address for a given owner + salt,         WITHOUT deploying anything. Used by the frontend to show the         user their wallet address immediately after sign-up."
				}
			},
			"notice": "Deploys AyuAccount smart wallets deterministically (CREATE2) so a         user's wallet address is known and can receive funds *before* the         contract is actually deployed. Deployment is triggered lazily by         the first UserOperation (standard ERC-4337 \"initCode\" pattern).",
